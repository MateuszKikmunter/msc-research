{
    "name": "msc-research",
    "private": true,
    "engines": {
        "node": ">=24.15.0"
    },
    "scripts": {
        "start": "concurrently --kill-others-on-fail --names backend,frontend --prefix-colors blue,magenta \"npm run start:backend\" \"npm run start:frontend\"",
        "start:backend": "npm --prefix src/backend start",
        "start:frontend": "npm --prefix src/frontend/analytics-pipeline-ui start",
        "test:experiments": "npm --prefix src/experiments test",
        "prepare": "husky",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yaml,yml}": "prettier --write"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "concurrently": "^9.2.4",
        "esbuild": "^0.28.1",
        "eslint": "^9.0.0",
        "globals": "^16.0.0",
        "husky": "^9.0.0",
        "lint-staged": "^16.0.0",
        "prettier": "^3.0.0",
        "typescript-eslint": "8.50.0"
    }
}
