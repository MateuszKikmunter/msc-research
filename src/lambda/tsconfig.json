{
    "compilerOptions": {
        "target": "ES2021",
        "module": "Node16",
        "outDir": "./dist",
        "types": ["node"],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["*.ts"],
    "exclude": ["node_modules", "dist"]
}
